/* The ready-made screens. Every colour, corner and the backdrop is a custom property on .kw-root: a game adds its own
   style sheet after this one and overrides them, for example  .kw-root { --kw-accent: #4da3ff; }  . The font is the
   engine's default; set -unity-font-definition on .kw-root to change it. */

.kw-root {
    --kw-accent: #ffbf23;
    --kw-accent-ink: #1d1d1f;
    --kw-surface: #1b1b1e;
    --kw-raised: #26262b;
    --kw-line: #34343a;
    --kw-text: #f5f5f7;
    --kw-muted: #a1a1a6;
    --kw-danger: #ff6b5e;
    --kw-radius: 16px;
    --kw-radius-sm: 10px;
    --kw-backdrop: rgba(0, 0, 0, 0.55);
    color: var(--kw-text);
    font-size: 15px;
}

.kw-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    align-items: center;
    justify-content: center;
    background-color: var(--kw-backdrop);
}

.kw-card {
    width: 420px;
    max-width: 100%;
    padding: 22px;
    background-color: var(--kw-surface);
    border-width: 1px;
    border-color: var(--kw-line);
    border-radius: var(--kw-radius);
}

.kw-card--wide {
    width: 560px;
}

.kw-root .kw-title {
    margin: 0 0 6px 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.kw-root .kw-body {
    margin: 0 0 16px 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 14px;
    white-space: normal;
}

.kw-root .kw-problem {
    margin: 0 0 14px 0;
    padding: 2px 0 2px 12px;
    border-left-width: 3px;
    border-left-color: var(--kw-danger);
    color: var(--kw-text);
    font-size: 14px;
    white-space: normal;
}

.kw-row {
    flex-direction: row;
    margin-bottom: 14px;
}

.kw-field {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
}

.kw-field--last {
    margin-right: 0;
}

.kw-root .kw-caption {
    margin: 0 0 6px 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 12px;
}

.kw-root .kw-dropdown {
    margin: 0;
}

.kw-root .kw-dropdown .unity-base-popup-field__input {
    height: 44px;
    margin: 0;
    padding: 0 10px;
    background-color: var(--kw-raised);
    border-width: 1px;
    border-color: var(--kw-line);
    border-radius: var(--kw-radius-sm);
    color: var(--kw-text);
    font-size: 15px;
}

.kw-root .kw-dropdown:focus .unity-base-popup-field__input {
    border-color: var(--kw-accent);
}

.kw-root .kw-dropdown .unity-base-popup-field__text {
    color: var(--kw-text);
}

.kw-agree {
    flex-direction: row;
    align-items: flex-start;
    margin: 4px 0 18px 0;
}

.kw-root .kw-check {
    margin: 0 10px 0 0;
    padding: 0;
}

.kw-root .kw-check .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    margin: 1px 0 0 0;
    background-image: none;
    background-color: var(--kw-raised);
    border-width: 2px;
    border-color: var(--kw-line);
    border-radius: 5px;
}

.kw-root .kw-check:focus .unity-toggle__checkmark {
    border-color: var(--kw-accent);
}

.kw-root .kw-check:checked .unity-toggle__checkmark,
.kw-root .kw-check .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--kw-accent);
    border-color: var(--kw-accent);
}

.kw-sentence {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    flex-grow: 1;
    align-items: center;
}

.kw-root .kw-sentence-text {
    margin: 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 14px;
    white-space: normal;
}

.kw-root .kw-link {
    margin: 0;
    padding: 0;
    min-height: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--kw-accent);
    font-size: 14px;
    -unity-font-style: bold;
}

.kw-root .kw-link:hover,
.kw-root .kw-link:active,
.kw-root .kw-link:focus {
    background-color: rgba(0, 0, 0, 0);
    color: var(--kw-text);
}

.kw-root .kw-button {
    min-height: 46px;
    margin: 0 0 8px 0;
    padding: 0 16px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--kw-radius-sm);
    background-color: var(--kw-accent);
    color: var(--kw-accent-ink);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kw-root .kw-button:hover,
.kw-root .kw-button:active {
    background-color: var(--kw-accent);
    opacity: 0.9;
}

.kw-root .kw-button:focus {
    border-color: var(--kw-text);
}

.kw-root .kw-button--ghost,
.kw-root .kw-button--ghost:hover,
.kw-root .kw-button--ghost:active {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--kw-line);
    color: var(--kw-text);
}

.kw-root .kw-button--ghost:focus {
    border-color: var(--kw-accent);
}

.kw-saves {
    flex-direction: row;
    margin-bottom: 14px;
}

.kw-root .kw-save {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 10px 0 0;
    padding: 14px;
    align-items: flex-start;
    border-width: 2px;
    border-color: var(--kw-line);
    border-radius: var(--kw-radius-sm);
    background-color: var(--kw-raised);
    color: var(--kw-text);
    -unity-text-align: upper-left;
}

.kw-root .kw-save:hover,
.kw-root .kw-save:active {
    background-color: var(--kw-raised);
}

.kw-root .kw-save--last {
    margin-right: 0;
}

.kw-root .kw-save--picked,
.kw-root .kw-save--picked:hover {
    border-color: var(--kw-accent);
}

.kw-root .kw-save:focus {
    border-color: var(--kw-text);
}

.kw-save-image {
    align-self: stretch;
    height: 90px;
    margin-bottom: 8px;
    border-radius: 6px;
}

.kw-save-name {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.kw-root .kw-save-label {
    margin: 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 14px;
    -unity-font-style: bold;
}

.kw-root .kw-tag {
    margin: 0 0 0 6px;
    padding: 1px 7px;
    border-radius: 999px;
    background-color: var(--kw-accent);
    color: var(--kw-accent-ink);
    font-size: 11px;
    -unity-font-style: bold;
}

.kw-root .kw-meta {
    margin: 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 12px;
    white-space: normal;
}

.kw-root .kw-code {
    margin: 2px 0 14px 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kw-root .kw-center {
    -unity-text-align: middle-center;
}

.kw-qr {
    align-self: center;
    margin-bottom: 14px;
    background-color: #ffffff;
}

.kw-hints {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.kw-hint {
    flex-direction: row;
    align-items: center;
    margin: 0 10px;
}

.kw-root .kw-glyph {
    width: 22px;
    height: 22px;
    margin: 0 6px 0 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--kw-muted);
    border-radius: 11px;
    color: var(--kw-muted);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kw-root .kw-hint-text {
    margin: 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 12px;
}

.kw-corner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.kw-toast {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 460px;
    max-width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 14px 14px 14px 16px;
    background-color: var(--kw-surface);
    border-width: 1px;
    border-color: var(--kw-line);
    border-radius: var(--kw-radius);
}

.kw-toast-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.kw-root .kw-toast .kw-button {
    min-height: 38px;
    margin: 0 0 0 6px;
    font-size: 14px;
}

.kw-root .kw-toast-title {
    margin: 0 0 2px 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.kw-root .kw-toast-body {
    margin: 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 13px;
    white-space: normal;
}

.kw-wrap {
    align-self: flex-start;
}

.kw-root .kw-signin {
    min-height: 44px;
    margin: 0;
    padding: 0 18px 0 12px;
    flex-direction: row;
    align-items: center;
}

.kw-root .kw-mark {
    width: 22px;
    height: 22px;
    margin: 0 8px 0 0;
    padding: 0;
    border-radius: 6px;
    background-color: var(--kw-accent-ink);
    color: var(--kw-accent);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.kw-root .kw-signin-text {
    margin: 0;
    padding: 0;
    color: var(--kw-accent-ink);
    font-size: 15px;
    -unity-font-style: bold;
}

.kw-root .kw-chip {
    margin: 0;
    padding: 6px 14px 6px 6px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--kw-line);
    border-radius: 999px;
    background-color: var(--kw-surface);
    color: var(--kw-text);
}

.kw-root .kw-chip:hover,
.kw-root .kw-chip:active {
    background-color: var(--kw-raised);
}

.kw-root .kw-chip:focus {
    border-color: var(--kw-accent);
}

.kw-avatar {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 16px;
    background-color: var(--kw-raised);
    overflow: hidden;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.kw-root .kw-avatar-letter {
    margin: 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 14px;
    -unity-font-style: bold;
}

.kw-who {
    justify-content: center;
}

.kw-root .kw-who-name {
    margin: 0;
    padding: 0;
    color: var(--kw-text);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.kw-root .kw-who-small {
    margin: 0;
    padding: 0;
    color: var(--kw-muted);
    font-size: 11px;
    -unity-text-align: upper-left;
}

.kw-menu {
    position: absolute;
    left: 0;
    top: 100%;
    min-width: 200px;
    margin-top: 6px;
    padding: 6px;
    background-color: var(--kw-surface);
    border-width: 1px;
    border-color: var(--kw-line);
    border-radius: var(--kw-radius-sm);
}

.kw-root .kw-menu .kw-button {
    min-height: 40px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--kw-text);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.kw-root .kw-menu .kw-button:hover,
.kw-root .kw-menu .kw-button:active {
    background-color: var(--kw-raised);
}

.kw-root .kw-menu .kw-button:focus {
    border-color: var(--kw-accent);
}
